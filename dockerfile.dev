# syntax=docker/dockerfile:1
# Entorno de desarrollo de bff-coordinadores (Cloudflare Worker).
# Todo el tooling (npm, wrangler, vitest, biome, tsc) corre acá; no hace falta Node en el host.
#
#   docker compose -f compose.dev.yml build
#   docker compose -f compose.dev.yml run --rm bff npm test
#   docker compose -f compose.dev.yml up            # wrangler dev en http://localhost:8788

FROM node:22-bookworm-slim

# git: lo usa wrangler para metadata de deploy. ca-certificates: descargas de workerd.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

ENV WRANGLER_SEND_METRICS=false \
    CI=true

WORKDIR /app

# Dependencias primero para aprovechar la cache de capas.
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .

EXPOSE 8787
CMD ["npm", "run", "dev", "--", "--ip", "0.0.0.0", "--port", "8787"]
